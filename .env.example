# SoulLetter server configuration
#
# Copy to .env.local (development) or set in your hosting environment. Every variable is
# optional and has a safe default. Empty values are treated as "not set". Never commit
# real secrets; .env* files other than this example are git-ignored.
#
# Malformed values (e.g. EPHEMERIS_PROVIDER=foo) are reported at runtime as a
# configuration error naming the variable (never its value). A missing or weak
# SHARE_TOKEN_SECRET never crashes the app; it only disables sharing.

# -----------------------------------------------------------------------------
# Ephemeris
# -----------------------------------------------------------------------------

# "astronomy-engine" (default, MIT licensed) or "swiss-ephemeris".
EPHEMERIS_PROVIDER=astronomy-engine

# Required when EPHEMERIS_PROVIDER=swiss-ephemeris: "agpl" or "professional".
# Swiss Ephemeris is dual-licensed: AGPL-3.0, or the commercial Swiss Ephemeris
# Professional License from Astrodienst. Running it in a network service under the
# AGPL obliges you to offer the complete corresponding source code of the whole
# service to its users. The server refuses to use Swiss Ephemeris until you declare
# which licence applies.
SWISS_EPHEMERIS_LICENSE=

# Optional directory containing Swiss Ephemeris data files (*.se1). When unset, the
# built-in Moshier ephemeris is used by the Swiss Ephemeris provider.
SWISS_EPHEMERIS_PATH=

# -----------------------------------------------------------------------------
# Share links
# -----------------------------------------------------------------------------

# Secret used to encrypt and authenticate share tokens (AES-256-GCM, key derived with
# HKDF-SHA256). Must be at least 32 characters; a shorter value disables sharing.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#  - production (NODE_ENV=production): sharing is disabled when this is not set.
#  - development/test: an ephemeral random secret is generated per process when this is
#    not set, so share links stop working after a restart.
# Changing the secret invalidates every existing share link.
SHARE_TOKEN_SECRET=

# Share-link lifetime in days, integer 1..365. Default 30.
SHARE_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Place search (geocoding)
# -----------------------------------------------------------------------------

# "open-meteo" (default) or "disabled". When disabled, users enter latitude, longitude
# and time zone manually and GET /api/v1/geocode returns 503 GEOCODING_DISABLED.
GEOCODING_PROVIDER=open-meteo

# Open-Meteo's free geocoding API (https://geocoding-api.open-meteo.com/v1/search) is for
# NON-COMMERCIAL use only. Commercial deployments need an Open-Meteo API subscription:
# when this key is set, requests go to the customer host
# (https://customer-geocoding-api.open-meteo.com/v1/search) with &apikey=<key>.
# Results are based on GeoNames data (CC BY 4.0); the UI shows the attribution.
OPEN_METEO_API_KEY=

# Optional override of the geocoding search endpoint (absolute http(s) URL), e.g. for a
# self-hosted Open-Meteo instance. Takes precedence over the host chosen above.
OPEN_METEO_GEOCODING_URL=

# -----------------------------------------------------------------------------
# Rate limiting (requests per minute per client key, integers 1..1000)
# -----------------------------------------------------------------------------
# Limits are kept in the memory of each server process. With several instances the
# effective limit is multiplied by the number of instances; use a shared store or
# enforce limits at your reverse proxy / edge for multi-instance deployments.

# POST /api/v1/readings (the chart endpoint uses the same limit in its own bucket).
RATE_LIMIT_READINGS_PER_MINUTE=20
# GET /api/v1/geocode
RATE_LIMIT_GEOCODE_PER_MINUTE=30
# POST /api/v1/share
RATE_LIMIT_SHARE_PER_MINUTE=10

# "true" or "false" (default). Only set to "true" when the app runs behind a trusted
# reverse proxy that sets/overwrites X-Forwarded-For or X-Real-IP; the client IP is then
# taken from the left-most valid X-Forwarded-For entry (else X-Real-IP), and IPv6
# clients are grouped by /64. When "false", forwarding headers are ignored (clients can
# forge them) and ALL clients share a single rate-limit bucket ("global").
TRUST_PROXY_HEADERS=false
